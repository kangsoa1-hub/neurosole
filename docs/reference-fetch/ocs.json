reation":"2015-03-03","dateOfRevision":"2022-04-08","electronicPublicationDate":"2015-03-02","firstPublicationDate":"2015-03-02","firstIndexDate":"2015-03-03","hasEvaluations":"N"},{"id":"26702642","source":"MED","pmid":"26702642","doi":"10.1080/13825585.2015.1127321","title":"The Hong Kong version of the Oxford Cognitive Screen (HK-OCS): validation study for Cantonese-speaking chronic stroke survivors.","authorString":"Kong AP, Lam PH, Ho DW, Lau JK, Humphreys GW, Riddoch J, Weekes B.","authorList":{"author":[{"fullName":"Kong AP","lastName":"Kong","firstName":"Anthony Pak-Hin","initials":"AP","authorId":{"type":"ORCID","value":"0000-0002-6211-0358"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"a Department of Communication Sciences and Disorders , University of Central Florida , Orlando , FL , USA."}]}},{"fullName":"Lam PH","lastName":"Lam","firstName":"Pinky Hiu-Ping","initials":"PH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"b Laboratory for Communication Sciences , The University of Hong Kong , Hong Kong SAR."}]}},{"fullName":"Ho DW","lastName":"Ho","firstName":"Diana Wai-Lam","initials":"DW","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"c Department of Chinese and Bilingual Studies , The Polytechnic University of Hong Kong , Hong Kong SAR."}]}},{"fullName":"Lau JK","lastName":"Lau","firstName":"Johnny King","initials":"JK","authorId":{"type":"ORCID","value":"0000-0002-3958-5582"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"d School of Psychology , University of Birmingham , Birmingham , UK."}]}},{"fullName":"Humphreys GW","lastName":"Humphreys","firstName":"Glyn W","initials":"GW","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"e Department of Experimental Psychology , University of Oxford , Oxford , UK."}]}},{"fullName":"Riddoch J","lastName":"Riddoch","firstName":"Jane","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"e Department of Experimental Psychology , University of Oxford , Oxford , UK."}]}},{"fullName":"Weekes B","lastName":"Weekes","firstName":"Brendan","initials":"B","authorId":{"type":"ORCID","value":"0000-0002-2412-7933"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"b Laboratory for Communication Sciences , The University of Hong Kong , Hong Kong SAR."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2412-7933"},{"type":"ORCID","value":"0000-0002-3958-5582"},{"type":"ORCID","value":"0000-0002-6211-0358"}]},"journalInfo":{"issue":"5","volume":"23","journalIssueId":2412211,"dateOfPublication":"2016 Sep","monthOfPublication":9,"yearOfPublication":2016,"journal":{"medlineAbbreviation":"Neuropsychol Dev Cogn B Aging Neuropsychol Cogn","title":"Neuropsychology, development, and cognition. Section B, Aging, neuropsychology and cognition","essn":"1744-4128","issn":"1382-5585","nlmid":"9614434","isoabbreviation":"Neuropsychol Dev Cogn B Aging Neuropsychol Cogn"},"printPublicationDate":"2016-09-01"},"pubYear":"2016","pageInfo":"530-548","abstractText":"This study reports the validation of the Hong Kong version of Oxford Cognitive Screen (HK-OCS). Seventy Cantonese-speaking healthy individuals participated to establish normative data and 46 chronic stroke survivors were assessed using the HK-OCS, Albert's Test of Visual Neglect, short test of gestural production, and Hong Kong version of the following assessments: Western Aphasia Battery, MMSE, MoCA, Modified Barthel Index, and Lawton Instrumental Activities of Daily Living scale. The validity of the HK-OCS was appraised by the difference between the two participant groups. Neurologically unimpaired individuals performed significantly better than stroke survivors on the HK-OCS. Positive and significant correlations found between cognitive subtests in the HK-OCS and related assessments indicated good concurrent validity. Excellent intra-rater and inter-rater reliabilities, fair test-retest reliability, and acceptable internal consistency suggested that the HK-OCS had good reliability. Specific HK-OCS subtests including semantics, episodic memory, number writing, and orientation were the best predictors of functional outcomes.","affiliation":"a Department of Communication Sciences and Disorders , University of Central Florida , Orlando , FL , USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"grantsList":{"grant":[{"agency":"NIHR (UK)","grantId":"Oxford cognitive health Clinical Research Facility","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Aphasia","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"Y","abbreviation":"ET","qualifierName":"etiology"}]}},{"majorTopic_YN":"N","descriptorName":"Activities of Daily Living","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PX","qualifierName":"psychology"}]}},{"majorTopic_YN":"N","descriptorName":"Reproducibility of Results"},{"majorTopic_YN":"N","descriptorName":"Gestures"},{"majorTopic_YN":"N","descriptorName":"Memory"},{"majorTopic_YN":"N","descriptorName":"Attention"},{"majorTopic_YN":"N","descriptorName":"Cognition Disorders","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"Y","abbreviation":"ET","qualifierName":"etiology"}]}},{"majorTopic_YN":"Y","descriptorName":"Neuropsychological Tests","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ST","qualifierName":"standards"}]}},{"majorTopic_YN":"Y","descriptorName":"Translating"},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorName":"Aged"},{"majorTopic_YN":"N","descriptorName":"Aged, 80 and over"},{"majorTopic_YN":"N","descriptorName":"Middl